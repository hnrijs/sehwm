[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 150
    offset = 10x40
    origin = top-right
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 10
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#61AFEF"
    separator_color = "frame"
    sort = yes

    font = JetBrainsMono Nerd Font Bold 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#121212"
    foreground = "#E0E0E0"
    timeout = 4

[urgency_normal]
    background = "#121212"
    foreground = "#E0E0E0"
    timeout = 6

[urgency_critical]
    background = "#121212"
    foreground = "#E0E0E0"
    frame_color = "#E06C75"
    timeout = 0
